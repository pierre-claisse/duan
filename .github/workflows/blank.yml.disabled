# Serve a blank page at https://duan.life. INERT while this file ends in
# `.disabled` (Actions only runs .yml/.yaml).
#
# Unpublishes the app: deploys the hand-written static site in `offline/` (an
# empty, noindex page + a matching 404 so deep links stay blank too) instead of
# the Vite build. Keeping `offline/CNAME` re-binds duan.life to this repository,
# so the DNS records cannot be claimed by anyone else.
#
# To unpublish: rename this file to `blank.yml` and
# `.github/workflows/deploy.yml` to `deploy.yml.disabled`, then push to main.
# Swap them back to republish.
name: Deploy (blank)

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
        with:
          # Pages was unpublished by hand; turn it back on for the blank site.
          enablement: true
      # No npm, no build, no scripts/build-secrets.mjs — the encrypted PAT
      # bundle is deliberately not published any more.
      - uses: actions/upload-pages-artifact@v3
        with:
          path: offline

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
